# =============================================================================
# NKB GLOBAL HUNTER - SERVER CONFIGURATION TEMPLATE
# =============================================================================

# Server Port
PORT=5000
NODE_ENV=staging

# JWT Authentication
# Mandatory 64+ char secret string
JWT_SECRET=REPLACE_WITH_SECURE_64_CHAR_HEX_KEY_FOR_PRODUCTION
JWT_EXPIRES_IN=7d

# Initial Administrator Credentials (Only used during initial seed if users table is empty)
ADMIN_EMAIL=admin@nkb-hunter.local
ADMIN_PASSWORD=Admin@NKB2026!

# Database Configuration (PostgreSQL 14+ for Production / Hostinger VPS)
# When DATABASE_URL is set, connects to PostgreSQL; when omitted locally, uses embedded database
DATABASE_URL=postgres://nkb_hunter_user:REPLACE_WITH_DB_PASSWORD@localhost:5432/nkb_global_hunter_staging
# PGSSL=false

# Optional External AI API Keys (System operates in free-first heuristic mode if omitted)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_HOST=http://localhost:11434

# Optional SMTP Provider (Zero-send policy enforced by default until approved by human)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Allowed Client Origin
CORS_ORIGIN=http://localhost:3000
